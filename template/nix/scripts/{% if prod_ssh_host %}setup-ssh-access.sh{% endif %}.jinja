# shellcheck shell=bash
# SSH key + config for the remote servers. The key pair is made once and never
# regenerated. .ssh/config is generated from the hosts in the copier answers, so
# rerun this after a template update that changed them: a config that differs is
# replaced, the old one kept as .ssh/config.bak and the difference shown.
# The key has no passphrase: the deploy and prod-ops scripts use it
# non-interactively.
set -e
KEY="$PWD/.ssh/odoo{{ odoo_major }}"
CONFIG="$PWD/.ssh/config"
mkdir -p "$PWD/.ssh"
if [ ! -f "$KEY" ]; then
    echo "Configuring ssh access for servers..."
    ssh-keygen -t ed25519 -N '' -f "$KEY"
    echo "Ask your admin to add this public key to the servers:"
    cat "$KEY.pub"
    echo
fi
NEW="$(mktemp "$CONFIG.XXXXXX")"
trap 'rm -f "$NEW"' EXIT
cat > "$NEW" << EOF
Host prod
  HostName {{ prod_ssh_host }}
  User {{ prod_ssh_user }}
  IdentityFile $KEY
  ServerAliveInterval 60
  ServerAliveCountMax 3
{% if prod_local_ssh_host %}
Host prod-local
  HostName {{ prod_local_ssh_host }}
  User {{ prod_ssh_user }}
  IdentityFile $KEY
  ServerAliveInterval 60
  ServerAliveCountMax 3
{% endif %}
{% for alias, host in test_ssh_hosts.items() %}
Host {{ alias }}
  HostName {{ host }}
  User {{ test_ssh_user }}
  Port {{ test_ssh_port }}
  IdentityFile $KEY
  ServerAliveInterval 60
  ServerAliveCountMax 3
{% endfor %}
EOF
chmod 644 "$NEW"
if [ ! -f "$CONFIG" ]; then
    mv "$NEW" "$CONFIG"
    echo "Wrote $CONFIG"
elif cmp -s "$NEW" "$CONFIG"; then
    echo "$CONFIG is up to date"
else
    cp -p "$CONFIG" "$CONFIG.bak"
    echo "$CONFIG differs from the hosts in the copier answers; replacing it (the old one: $CONFIG.bak):"
    diff -u --label "$CONFIG.bak" --label "$CONFIG" "$CONFIG.bak" "$NEW" || true
    mv "$NEW" "$CONFIG"
fi

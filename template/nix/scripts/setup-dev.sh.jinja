# shellcheck shell=bash
{% if dev_in_worktrees %}
# Development setup: .env, addon repos, the local postgres cluster{% if backup_s3_bucket %}, S3 access for
# the prod dump{% endif %}{% if prod_ssh_host %}, ssh{% endif %}{% if editor == 'vscode' %} and editor settings{% endif %}. No main Odoo and no
# reverse proxy: every task runs in its own worktree env (worktree-env skill),
# served on its own port, with its own database in this cluster.
# The called scripts are on PATH (injected by flake.nix).
set -e
echo "=== Running create-env ==="
create-env
echo
echo "=== Running update-repos ==="
update-repos
echo
echo "=== Running setup-postgres ==="
setup-postgres
{% if backup_s3_bucket %}
echo
echo "=== Running create-aws-config ==="
create-aws-config
{% endif %}
{% else %}
# Full development setup: prod + local postgres + test{% if prod_ssh_host %} + ssh{% endif %}{% if editor == 'vscode' %} + editor settings{% endif %}.
# The called scripts are on PATH (injected by flake.nix).
set -e
echo "=== Running setup of production server  ==="
setup-prod
echo
echo "=== Running setup-postgres ==="
setup-postgres
echo
echo "=== Running setup of test server  ==="
setup-test
{% endif %}
{% if prod_ssh_host %}
echo
echo "=== Running setup-ssh-access ==="
setup-ssh-access
{% endif %}
{% if editor == 'vscode' %}
echo
echo "=== Running create-vscode-settings ==="
create-vscode-settings
{% endif %}
echo
echo "=== Development setup complete! ==="

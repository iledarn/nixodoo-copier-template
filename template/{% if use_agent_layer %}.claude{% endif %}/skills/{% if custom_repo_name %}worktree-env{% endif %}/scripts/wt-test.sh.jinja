#!/usr/bin/env bash
# One-shot Odoo run against a session env, a test run above all, with what it
# needs beside the session's own service:
#   - the session conf and DB;
#   - a free port, so a browser tab left on <URL> cannot reach the tests;
#   - the IPv4 loopback: HttpCase talks to 127.0.0.1 (odoo.tests HOST), while the
#     session conf listens on ::1 (WT_HTTP_INTERFACE, wt-common.sh);
#   - a dbfilter naming the session DB: the conf's ^%d$ maps the Host 127.0.0.1
#     to no database at all.
# Still loopback only, so the prod copy never reaches the LAN. Stop the session's
# service first when the run updates modules (-u / -i): one process per DB.
#
# Runs on one env take turns on an exclusive flock of .worktrees/_env/<slug>/test.lock,
# held for the whole Odoo run: a second run waits, a run wrapped in that flock runs under it.
#
# Two runs that would exit 0 having tested nothing are refused:
#   - a module in -u that the session DB does not have installed (a seed dump
#     older than the module), or a -u/-i list with a space (Odoo reads ' name'
#     verbatim and skips it): -u updates nothing and runs none of its tests.
#     Stops before Odoo starts, naming the -i or the spelling it needs (exit 2);
#   - a --test-enable/--test-tags run whose summary line reports 0 tests, e.g. a
#     selector naming no test such as a bare `--test-tags module` (exit 3).
#     Odoo writes no summary for --test-file alone, so that run is not counted;
#     a summary missing from the output (a --logfile of your own) only warns.
#
# Usage: wt-test.sh <slug> <odoo args...>
#   wt-test.sh kio-1234-x -u {{ module_prefix }}_mod --test-enable --test-tags /{{ module_prefix }}_mod
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/wt-common.sh"

SLUG="${1:?usage: wt-test.sh <slug> <odoo args...>}"
shift
DB="$(db_name_for "$SLUG")"
CONF="$WT_ENVROOT/$SLUG/odoo.conf"
[ -f "$CONF" ] || { echo "ERROR: no session conf at $CONF - run wt-start.sh $SLUG first" >&2; exit 1; }
TEST_LOCK="$WT_ENVROOT/$SLUG/test.lock"

# Whether this process or one up its parent chain holds the lock, as in a run wrapped
# in `flock <lock>`: waiting would wait on itself. fdinfo lists the locks an fd holds.
held_by_caller() {
    local lock_id pid=$$ fdinfo
    lock_id="$(stat -c %d:%i "$TEST_LOCK")"
    while [ "${pid:-0}" -gt 1 ]; do
        while read -r fdinfo; do
            [ "$(stat -Lc %d:%i "/proc/$pid/fd/${fdinfo##*/}" 2>/dev/null)" != "$lock_id" ] || return 0
        done < <(grep -ls '^lock:.*FLOCK' "/proc/$pid/fdinfo/"*)
        pid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)"
    done
    return 1
}

# " (pid N: command)" of the holder when known: a wt-test.sh holder writes its pid into
# the file, as the flock(1) that took the lock for it is gone; a wrapper's is in /proc/locks.
lock_holder() {
    local inode pid
    inode="$(stat -c %i "$TEST_LOCK")"
    for pid in $(tr -cd '0-9\n' < "$TEST_LOCK") $(awk -v inode=":$inode" \
            '$2 == "FLOCK" && substr($6, length($6) - length(inode) + 1) == inode {print $5}' /proc/locks 2>/dev/null); do
        if [ -r "/proc/$pid/cmdline" ]; then
            printf ' (pid %s: %s)' "$pid" "$(tr '\0' ' ' < "/proc/$pid/cmdline" | sed 's/ $//')"
            return 0
        fi
    done
}

# What the run installs and updates, and whether Odoo counts its tests: only
# --test-enable and --test-tags set the test_enable its summary line needs.
UPDATE=""
INIT=""
TESTS=0
NEXT=""
for arg in "$@"; do
    case "$NEXT" in
        update) UPDATE="$UPDATE,$arg"; NEXT=""; continue ;;
        init) INIT="$INIT,$arg"; NEXT=""; continue ;;
    esac
    case "$arg" in
        -u | --update) NEXT=update ;;
        --update=*) UPDATE="$UPDATE,${arg#--update=}" ;;
        -u*) UPDATE="$UPDATE,${arg#-u}" ;;
        -i | --init) NEXT=init ;;
        --init=*) INIT="$INIT,${arg#--init=}" ;;
        -i*) INIT="$INIT,${arg#-i}" ;;
        --test-enable | --test-tags | --test-tags=*) TESTS=1 ;;
    esac
done
UPDATE="${UPDATE#,}"
INIT="${INIT#,}"

for modules in "$UPDATE" "$INIT"; do
    case "$modules" in
        *[[:space:]]*)
            echo "ERROR: '$modules' has a space, and Odoo skips ' name' as no module:" \
                 "write ${modules//[[:space:]]/}" >&2
            exit 2 ;;
    esac
done

# Taken before the module-state check: the run being waited for may install a module. Odoo
# inherits fd 9 through the exec below; append mode keeps a waiter from wiping the holder's pid.
exec 9>>"$TEST_LOCK"
if flock -n 9; then
    echo "$$" > "$TEST_LOCK"
elif held_by_caller; then
    echo "STATUS: a caller of this run holds $TEST_LOCK (a flock wrapper?): running under its lock" >&2
else
    echo "STATUS: another run on $DB holds $TEST_LOCK$(lock_holder) - waiting for it to end, then running" >&2
    flock 9
    echo "$$" > "$TEST_LOCK"
fi

if [ -n "$UPDATE" ]; then
    # Any update run loads 'to upgrade' and 'to install' modules, and installs
    # those in -i; 'all' names no module.
    MISSING="$($PSQL -d "$DB" -tA -F ' ' -v ON_ERROR_STOP=1 -v modules="$UPDATE" -v init="$INIT" <<'SQL'
SELECT name, COALESCE(state, 'absent')
  FROM unnest(string_to_array(:'modules', ',')) AS name
  LEFT JOIN ir_module_module USING (name)
 WHERE name NOT IN ('', 'all') AND name <> ALL (string_to_array(:'init', ','))
   AND COALESCE(state, 'absent') NOT IN ('installed', 'to upgrade', 'to install');
SQL
)" || { echo "ERROR: cannot read module states from $DB (is the session up? wt-start.sh $SLUG)" >&2; exit 1; }
    if [ -n "$MISSING" ]; then
        while read -r name state; do
            echo "ERROR: $name is $state in $DB, so -u updates nothing and runs none of its tests" \
                 "(the seed dump predates it?): install it with -i $name" >&2
        done <<< "$MISSING"
        exit 2
    fi
fi

# Picked under the lock: one chosen before a long wait may be taken by then.
PORT="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
ODOO=("$HOME/{{ nix_profile_rel }}/bin/odoo" -c "$CONF" --workers 0 --stop-after-init --logfile=
      --http-interface 127.0.0.1 --http-port "$PORT" --db-filter "^${DB}\$")

[ "$TESTS" -eq 1 ] || exec "${ODOO[@]}" "$@"

# A test run: the output passes through, and the count Odoo reports last
# ("odoo.tests.result: F failed, E error(s) of N tests when loading database")
# decides whether anything ran. The log handler keeps that INFO line in the
# output under any --log-level.
LOG="$(mktemp)"
trap 'rm -f "$LOG"' EXIT
set +e
"${ODOO[@]}" --log-handler odoo.tests.result:INFO "$@" 2>&1 | tee "$LOG"
RC=${PIPESTATUS[0]}
set -e
[ "$RC" -eq 0 ] || exit "$RC"
COUNT="$(sed -n 's/.*odoo\.tests\.result: .* of \([0-9][0-9]*\) tests when loading database.*/\1/p' "$LOG" | tail -n 1)"
if [ -z "$COUNT" ]; then
    echo "WARNING: no test summary in the output (a --logfile of your own?): the test count was not checked" >&2
elif [ "$COUNT" -eq 0 ]; then
    echo "ERROR: the run executed 0 tests: check the selector (/module, /module:Class," \
         "/module:Class.test_method) and that the module is installed in $DB" >&2
    exit 3
fi

# shellcheck shell=bash
# shellcheck disable=SC2034  # vars are consumed by the sourcing wt-*.sh scripts
# Shared config + helpers for per-session pipeline worktree envs.
# Sourced by the wt-*.sh scripts — not run directly.
#
# Model: every parallel pipeline session gets its OWN isolated env —
#   worktree  .worktrees/<slug>/            (git checkout, the code)
#   runtime   .worktrees/_env/<slug>/       (odoo.conf, data_dir, port file)
#   DB        wt_<slug>                      (independent restore of the prod dump)
#   service   odoo{{ service_suffix }}-wt@<slug>.service         (own Odoo on its own port)
#   env repo  .worktrees/_envrepo/<slug>/   (wt-start --env-repo only: this project's own
#                                             repo on branch <slug>, for the task's scripts/ADRs)
# Nothing is shared between sessions except the read-only seed dump, the
# pinned OCA/CE module sources and the postgres cluster. There is no main env:
# no main Odoo, no reverse proxy, no main database; every pipeline run works here.
# A session is served at http://wt_<slug>.localhost:<port> (dbfilter ^%d$).
# On a shared test server the WT_* overrides below move postgres to another host
# and serve the session on the LAN as http://wt_<slug>.<WT_HOST_SUFFIX>:<port>.

PROJ="${{ "{" }}{{ project_dir_var }}:-$HOME/{{ project_name }}}"
# Exported: the odoo wrapper finds the project through it, else through the cwd. A dev
# shell sets it; a plain SSH login on a shared test server does not (wt-test.sh from /tmp).
export {{ project_dir_var }}="$PROJ"
SRC_REPO="$PROJ/src/{{ custom_repo_name }}"               # nested addons repo (the user's main checkout)
MAIN_FARM="$PROJ/.local/share/Odoo/addons/{{ odoo_version }}"   # main symlink farm — source of truth for OCA/CE targets

WT_ROOT="$PROJ/.worktrees"                         # per-run git worktrees (gitignored)
WT_ENVROOT="$WT_ROOT/_env"                         # per-session runtime (conf/data/port)
WT_ENVREPO_ROOT="$WT_ROOT/_envrepo"                 # per-run worktrees of the project repo itself
BACKUP_DIR="$PROJ/backup"                           # prod seed dump lives here
LOCKFILE="$WT_ROOT/.wt.lock"                        # serializes port alloc + git worktree add

PORT_BASE={{ (odoo_major | int + 11) * 100 }}                                      # session http ports live in [{{ (odoo_major | int + 11) * 100 }}, {{ (odoo_major | int + 11) * 100 + 99 }}]
PORT_MAX={{ (odoo_major | int + 11) * 100 + 99 }}

# Per-host overrides, read from WT_* lines in $PROJ/.env (no quotes, nothing else
# from that file is read). Unset = local development, the defaults below. A shared
# test server sets e.g.
#   WT_DB_HOST=10.0.0.5  WT_DB_PORT=5432  WT_DB_PASSWORD=...
#   WT_HTTP_INTERFACE=0.0.0.0  WT_HOST_SUFFIX=odoo1.example.lan
# so sessions use that postgres and are browsed from the LAN. WT_HOST_SUFFIX must
# resolve at any depth (a wildcard record) to this host, as *.localhost does locally.
if [ -f "$PROJ/.env" ]; then
    while IFS='=' read -r key value; do
        printf -v "$key" '%s' "$value"
    done < <(grep -E '^WT_(DB_HOST|DB_PORT|DB_PASSWORD|HTTP_INTERFACE|HOST_SUFFIX)=' "$PROJ/.env" || true)
fi
WT_DB_HOST="${WT_DB_HOST:-localhost}"
WT_DB_PORT="${WT_DB_PORT:-{{ postgres_port }}}"
WT_DB_PASSWORD="${WT_DB_PASSWORD:-{{ db_password }}}"
WT_HTTP_INTERFACE="${WT_HTTP_INTERFACE:-::1}"
WT_HOST_SUFFIX="${WT_HOST_SUFFIX:-localhost}"

# Postgres (local default: localhost:{{ postgres_port }}, the shared cluster already up via
# postgres{{ service_suffix }}.service) — we never pg_ctl it, only create/drop DBs.
export PGPASSWORD="$WT_DB_PASSWORD"
# -X: a ~/.psqlrc (\timing on, say) would print into the output the scripts read back.
PSQL="psql -X -h $WT_DB_HOST -p $WT_DB_PORT -U {{ db_user }}"

WT_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

db_name_for() { echo "wt_${1//-/_}"; }                                   # slug -> safe pg identifier
session_host() { echo "$1.$WT_HOST_SUFFIX"; }                          # DB -> host whose first label is the DB (dbfilter ^%d$)
db_exists()   { $PSQL -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$1'" | grep -q 1; }
tree_dirty()  { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }  # uncommitted or untracked files in a worktree

# A session running in a Claude worktree of this project (<project>/.claude/worktrees/<name>,
# where the desktop app and EnterWorktree put them) cannot edit an env it brings up: the
# app's worktree guard refuses Edit/Write anywhere in the base checkout, and $WT_ROOT is
# inside it, though the code worktree there belongs to the addons repo. Refused before the
# restore, so the minutes go nowhere; WT_ALLOW_CLAUDE_WORKTREE=1 for a run that only reads.
refuse_in_claude_worktree() {
    local here proj
    here="$(pwd -P)"
    proj="$(cd "$PROJ" 2>/dev/null && pwd -P || echo "$PROJ")"
    case "$here/" in
        "$proj"/.claude/worktrees/*) ;;
        *) return 0 ;;
    esac
    [ -n "${WT_ALLOW_CLAUDE_WORKTREE:-}" ] && return 0
    cat >&2 <<EOF
ERROR: this session runs in a Claude worktree of the project ($here).
The desktop app's worktree guard refuses Edit/Write in the base checkout ($proj),
and the env's code worktree would be there ($1): the env would come up and none
of its files could be edited.
Run this work from a session in the base checkout (a session started without a
worktree of its own: use_worktree false). For a run that only reads or tests,
WT_ALLOW_CLAUDE_WORKTREE=1 brings the env up anyway.
EOF
    exit 4
}

# WITH (FORCE) refuses outright for a non-superuser role when any connection
# belongs to another role - an autovacuum worker analysing a fresh restore is
# enough (a shared server's postgres, where the role is no superuser). Then end
# this role's own connections and drop plainly: a plain drop stops autovacuum
# workers by itself.
drop_db() {
    $PSQL -d postgres -c "DROP DATABASE IF EXISTS $1 WITH (FORCE);" >/dev/null 2>&1 && return 0
    $PSQL -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$1' AND usename=current_user AND pid<>pg_backend_pid();" >/dev/null
    $PSQL -d postgres -c "DROP DATABASE IF EXISTS $1;" >/dev/null
}

# Whether this process or one up its parent chain holds the lock file $1, as in a run wrapped
# in `flock <lock>`: waiting would wait on itself. fdinfo lists the locks an fd holds.
held_by_caller() {
    local lock_id pid=$$ fdinfo
    lock_id="$(stat -c %d:%i "$1")"
    while [ "${pid:-0}" -gt 1 ]; do
        while read -r fdinfo; do
            [ "$(stat -Lc %d:%i "/proc/$pid/fd/${fdinfo##*/}" 2>/dev/null)" != "$lock_id" ] || return 0
        done < <(grep -ls '^lock:.*FLOCK' "/proc/$pid/fdinfo/"*)
        pid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)"
    done
    return 1
}

# " (pid N: command)" of the holder of lock file $1 when known: a take_test_lock holder writes
# its pid into the file, as the flock(1) that took the lock for it is gone; a wrapper's is in /proc/locks.
lock_holder() {
    local inode pid
    inode="$(stat -c %i "$1")"
    for pid in $(tr -cd '0-9\n' < "$1") $(awk -v inode=":$inode" \
            '$2 == "FLOCK" && substr($6, length($6) - length(inode) + 1) == inode {print $5}' /proc/locks 2>/dev/null); do
        if [ -r "/proc/$pid/cmdline" ]; then
            printf ' (pid %s: %s)' "$pid" "$(tr '\0' ' ' < "/proc/$pid/cmdline" | sed 's/ $//')"
            return 0
        fi
    done
}

# Takes the exclusive lock of env $1 (.worktrees/_env/<slug>/test.lock) on fd 9, held until
# exit or `flock -u 9`, waiting for and naming another holder; $2 says what follows the wait.
# Returns 2 when the file locked is no longer the one at the path: wt-stop removed the env,
# lock file included, while this run waited (a new env's runs lock a new file); 1 when unlockable.
take_test_lock() {
    local lock="$WT_ENVROOT/$1/test.lock"
    # append mode keeps a waiter from wiping the holder's pid
    exec 9>>"$lock" || return 1
    if ! flock -n 9; then
        if held_by_caller "$lock"; then
            echo "STATUS: a caller of this run holds $lock (a flock wrapper?): running under its lock" >&2
            return 0
        fi
        echo "STATUS: another run on $(db_name_for "$1") holds $lock$(lock_holder "$lock") - waiting for it to end, then $2" >&2
        flock 9 || return 1
    fi
    [ "$(stat -Lc %d:%i "/proc/$$/fd/9")" = "$(stat -Lc %d:%i "$lock" 2>/dev/null)" ] || return 2
    echo "$$" > "$lock"
}

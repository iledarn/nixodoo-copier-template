#!/usr/bin/env bash
# Show all active session envs (handy when several run in parallel).
# Usage: wt-list.sh
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/wt-common.sh"

# clean / dirty, or none when the env has no such worktree
tree_state() {
    if [ ! -d "$1" ]; then echo none
    elif tree_dirty "$1"; then echo dirty
    else echo clean
    fi
}

printf "%-30s %-5s %-36s %-9s %-9s %s\n" SLUG PORT DB SERVICE WORKTREE ENVREPO
[ -d "$WT_ENVROOT" ] || exit 0
for env_dir in "$WT_ENVROOT"/*/; do
    [ -d "$env_dir" ] || continue
    slug="$(basename "$env_dir")"
    port="$(cat "$env_dir/port" 2>/dev/null || echo '?')"
    # is-active prints the state and exits non-zero for any but active: keep what it printed
    svc="$(systemctl --user is-active "odoo{{ service_suffix }}-wt@$slug.service" 2>/dev/null)" || true
    [ -n "$svc" ] || svc=unknown
    printf "%-30s %-5s %-36s %-9s %-9s %s\n" "$slug" "$port" "$(db_name_for "$slug")" "$svc" \
        "$(tree_state "$WT_ROOT/$slug")" "$(tree_state "$WT_ENVREPO_ROOT/$slug")"
done

#!/usr/bin/env bash
# SessionStart hook: kb's pinned rules and a one-line standup go into the session context.
# stdout is context for Claude, not shown to the user. Without kb on PATH, or with this
# checkout not registered as its kb scope, it says so in one line that names the fix (nix run
# .#kb-setup). Never exits non-zero: a session must always start.
#
# Claude Code keeps at most 10,000 characters of a hook's output in context; past that the
# model gets a path and the first 2,000 characters. So the start carries the index header and
# its Pinned section (kb index lists the recent records) and one count line for the standup (kb
# today prints the list, the kb band shows it; nothing is recorded as shown), and whatever the
# model must act on (the compaction note, a stale schema, NO MEMORY) prints first. FIT then
# holds the whole output under BUDGET characters: past it the last pinned rules give way to a
# line naming kb index, then the end of the output to a line saying it was cut. Every session
# gets the same output, a pipeline child included. Notices (kb add --once) are the user's and
# live in the kb pane: the start never names them.
#
# The installed kb may predate --title, schema_stale or anything newer: each is tried, and a kb
# that does not know it gets the old call or nothing, so no error ever reaches the context.
set -u
# characters as Claude Code counts them, with room under its 10,000 for what it adds
BUDGET=9500
if ! command -v kb >/dev/null 2>&1; then
    echo "kb: kb is not installed, so this session has no project memory. To set it up: nix run .#kb-setup"
    exit 0
fi

INPUT=$(cat)
# One field per line, whitespace folded: a title holds spaces and could hold a newline.
{ read -r SESSION_ID; read -r SOURCE; read -r TITLE; } < <(printf '%s' "$INPUT" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
for key in ("session_id", "source", "session_title"):
    print(" ".join(str(d.get(key) or "").split()))
' 2>/dev/null)
SESSION_ID=${SESSION_ID:-}
SOURCE=${SOURCE:-}
TITLE=${TITLE:-}
export KB_SESSION="$SESSION_ID"
SCOPE="{{ project_name }}"
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

# One field of a JSON object ($1), '' when absent or unreadable.
json_field() {
    printf '%s' "$1" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin).get(sys.argv[1])
except (ValueError, AttributeError):
    v = None
print("" if v is None else json.dumps(v))
' "$2" 2>/dev/null
}

# The session skeleton; Claude writes the body at close (kb session close --body-file …).
# The title goes in as a hint; a kb from before --title refuses the option with a usage
# error (exit 2), and then the session opens without it.
open_session() {
    kb session open --scope "$SCOPE" --id "$SESSION_ID" --source "$SOURCE" "$@" 2>&1
}

# Everything the session start says, in the order it is read; FIT trims it to the budget.
context() {
    if [ "$SOURCE" = "compact" ]; then
        echo "kb: the context was just compacted. Before you continue, write the session note from the summary: kb session note \"<the decisions, what is done, the open threads>\"."
    fi

    # This checkout must be the kb scope "$SCOPE", or records made here land in another scope
    # and .kb/tags.toml is never read. `kb scope which` exits 3 for a path in no scope; a kb
    # from before `kb scope` fails another way, and then nothing is said.
    local registered rc status stale opened
    registered=$(kb scope which "$ROOT" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 3 ] || { [ "$rc" -eq 0 ] && [ "$registered" != "$SCOPE" ]; }; then
        echo "kb: this checkout is not registered as the kb scope $SCOPE, so records made here land elsewhere and .kb/tags.toml is not read. To fix: nix run .#kb-setup"
    fi

    status=$(kb --json status 2>/dev/null || true)
    if [ "$(json_field "$status" bolt_reachable)" != "true" ]; then
        echo "kb: neo4j-kb.service was not answering at session start; starting it (up to start_timeout)."
        if ! kb service start >/dev/null 2>&1; then
            echo "kb: NO MEMORY. Neo4j did not come up. Tell the user before anything else; then: kb status; journalctl --user -u neo4j-kb.service -n 100"
            return 0
        fi
        status=$(kb --json status 2>/dev/null || true)
    fi
    [ "$(json_field "$status" upgrade_pending)" = "true" ] && echo "kb: the unit runs an older neo4j than the installed package; run kb-setup."
    # schema_ok is null while Neo4j is unreachable (unknown, not stale); schema_stale is newer than some kb
    stale=$(json_field "$status" schema_stale)
    if [ "$(json_field "$status" schema_ok)" = "false" ] || { [ -n "$stale" ] && [ "$stale" != "[]" ]; }; then
        echo "kb: schema stale or incomplete; run kb-setup"
    fi

    # Optional Odoo pull ([sources.odoo] enabled); never fails.
    kb sync odoo 2>&1 | sed 's/^/kb: /'

    opened=""
    rc=2
    if [ -n "$TITLE" ]; then
        opened=$(open_session --title="$TITLE")
        rc=$?
    fi
    [ "$rc" -eq 2 ] && opened=$(open_session)
    [ -n "$opened" ] && printf '%s\n' "$opened" | sed "s/^/kb: session /"

    # The index: its header and the Pinned section; the other records only as a count.
    kb index --scope "$SCOPE" 2>/dev/null | awk '
        NR == 1 { print; next }
        /^## / { section = $0; if (section == "## Pinned") print "\n## Pinned"; next }
        /^- \[/ { if (section == "## Pinned") print; else recent++ }
        END { if (recent) printf "\n%d recent records are left out here: kb index lists them, kb search finds any record.\n", recent }
    '

    # The standup as one count line, and the sessions closed without a summary (the model is
    # asked to write those). A kb that cannot answer gives no line.
    kb today --scope "$SCOPE" --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    tasks = d["tasks"]
except (ValueError, KeyError, TypeError):
    sys.exit(0)
if d.get("error"):
    sys.exit(0)
loud = sum(1 for t in tasks if (t.get("level") or 0) >= 3)
quiet = d.get("quiet") or 0
print()
print(f"kb today: {len(tasks)} open tasks, {loud} loud, {quiet} quiet; the list is left out here: kb today prints it.")
pending = d.get("no_summary") or []
if pending:
    noun = "session" if len(pending) == 1 else "sessions"
    sid = pending[0].get("session_id") if len(pending) == 1 else "<session_id>"
    slugs = ", ".join(p.get("slug") or "-" for p in pending[:3])
    if len(pending) > 3:
        slugs += f" and {len(pending) - 3} more"
    print(f"kb: {len(pending)} {noun} without summary: {slugs}; write them: kb session close --id {sid} --body-file <f>")
' 2>/dev/null

    # Project-owned extras (not templated): entire fan-out check, stray files, anything local.
    # Contract: $1 = the SessionStart source, $2 = this session's id (also exported as
    # KB_SESSION). A local check that needs the live session MUST use that id and must never
    # ask a tool for "the current session": the other SessionStart hooks run in PARALLEL with
    # this one, so a tool answering from state on disk hands back the PREVIOUS session and the
    # check then chases a stale id. That is a real bug, shipped twice - see kaertech-odoo-16
    # PR #65 and kaertech-odoo-19 PR #3, where it cried "BROKEN fan-out" every single session.
    local extras
    extras="$(dirname "$0")/kb-session-start.local.sh"
    [ -x "$extras" ] && bash "$extras" "$SOURCE" "$SESSION_ID"
    return 0
}

# Holds stdin under argv[1] characters as Claude Code counts them (UTF-16 code units). Over it,
# the last pinned rules give way first, to one line naming kb index; if that is not enough, the
# output is cut at a line with a line saying so. What prints first is kept longest.
FIT='
import sys

budget = int(sys.argv[1])
lines = sys.stdin.buffer.read().decode("utf-8", "replace").rstrip("\n").split("\n")


def fits(candidate):
    return len(("\n".join(candidate) + "\n").encode("utf-16-le")) // 2 <= budget


if not fits(lines) and "## Pinned" in lines:
    start = lines.index("## Pinned") + 1
    end = start
    while end < len(lines) and lines[end].startswith("- ["):
        end += 1
    for keep in range(end - start - 1, -1, -1):
        note = f"+{end - start - keep} pinned rules left out to fit the context: kb index lists them"
        trial = lines[:start] + lines[start:start + keep] + [note] + lines[end:]
        if fits(trial):
            break
    if end > start:
        lines = trial
if not fits(lines):
    note = "kb: the session start was cut here to fit the context; kb index and kb today print the rest"
    kept = []
    for line in lines:
        if not fits(kept + [line, note]):
            break
        kept.append(line)
    lines = kept + [note]
sys.stdout.buffer.write(("\n".join(lines) + "\n").encode("utf-8"))
'

out=$(context)
fitted=$(printf '%s\n' "$out" | python3 -c "$FIT" "$BUDGET" 2>/dev/null) && [ -n "$fitted" ] || fitted=${out:0:BUDGET}
[ -n "$fitted" ] && printf '%s\n' "$fitted"
exit 0

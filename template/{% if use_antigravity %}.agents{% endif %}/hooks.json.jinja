{
  "claude-hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|grep_search|view_file|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/claude_hook.py\" pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/claude_hook.py\" post",
            "timeout": 30
          }
        ]
      }
    ]
  }{% if use_entire or use_kb or use_claude_code %},{% endif +%}
{% if use_entire %}
  "entire": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks antigravity pre-tool-use'"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks antigravity pre-invocation'"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks antigravity stop'",
        "timeout": 300
      }
    ]
  },
  "entire-fanout": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/entire-fanout.sh\" pre-tool-use"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/entire-fanout.sh\" pre-invocation"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/entire-fanout.sh\" stop",
        "timeout": 300
      }
    ]
  }{% if use_kb or use_claude_code %},{% endif +%}
{% endif %}
{% if use_kb %}
  "kb-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/claude_hook.py\" session-start",
        "timeout": 60
      }
    ]
  }{% if use_claude_code %},{% endif +%}
{% endif %}
{% if use_claude_code %}
  "redact-secrets": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.bun/bin:$PATH\"; if command -v bun >/dev/null 2>&1; then bun \"$(git rev-parse --show-toplevel)/.agents/hooks/redact.ts\"; else echo '{}'; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
{% endif %}
}

#!/usr/bin/env bash
# Replay one Antigravity hook payload into every nested entire-enabled repo under src/.
#
# The root repo is handled by the "entire" entry in .agents/hooks.json (managed by
# `entire agent add antigravity` and kept untouched so `entire status` / `entire doctor`
# verify it cleanly). This script fans the same payload out to nested repos under src/
# that have Entire's git hook installed (the custom addons checkout), matching
# .claude/hooks/entire-fanout.sh.
#
# Usage: entire-fanout.sh <phase>   e.g. pre-invocation, pre-tool-use, stop
set -u

phase=${1:?usage: entire-fanout.sh <phase>}
export PATH="$HOME/.local/bin:$PATH"
export ENTIRE_TEST_ANTIGRAVITY_BRAIN_DIR="${ENTIRE_TEST_ANTIGRAVITY_BRAIN_DIR:-$HOME/.gemini/antigravity/brain}"

command -v entire >/dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

if [ -t 0 ]; then
    payload=""
else
    payload=$(cat)
fi

for gitdir in "$root"/src/*/.git; do
    [ -e "$gitdir" ] || continue
    grep -qs 'entire hooks git' "$gitdir/hooks/prepare-commit-msg" || continue
    repo=$(dirname "$gitdir")
    printf '%s' "$payload" | (cd "$repo" && entire hooks antigravity "$phase") \
        >/dev/null 2>&1 || true
done

exit 0

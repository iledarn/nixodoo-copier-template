{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "Odoo Env & Worktrees",
  "description": "PostgreSQL service, git checkouts (env & addons), and Odoo worktree environments status and controls.",
  "has_web_ui": true,
  "env": {
    "UI_THEME_VERSION": "1"
  },
  "ui_config": {
    "display_name": "Odoo Env & Worktrees",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "Odoo Env & Worktrees"
      },
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "path": "/",
        "title": "Odoo Env & Worktrees"
      }
    ]
  }
}

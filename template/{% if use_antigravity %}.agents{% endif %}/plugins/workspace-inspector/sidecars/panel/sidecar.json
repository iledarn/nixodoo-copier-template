{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "Workspace Customizations",
  "description": "Displays workspace-scoped plugins (.agents/plugins), MCP servers & tools, custom agents, skills, rules, and hooks for the active project.",
  "has_web_ui": true,
  "env": {
    "UI_THEME_VERSION": "3"
  },
  "ui_config": {
    "display_name": "Workspace Customizations",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "Workspace Customizations"
      },
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "path": "/",
        "title": "Workspace Customizations"
      }
    ]
  }
}
